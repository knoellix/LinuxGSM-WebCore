      {"key": "ServerDescription",    "type": "text",     "label_de": "Beschreibung",         "label_en": "Description"},
      {"key": "ServerPassword",       "type": "text",     "label_de": "Server-Passwort",      "label_en": "Server password"},
      {"key": "AdminPassword",        "type": "password", "label_de": "Admin-Passwort",       "label_en": "Admin password"},
      {"key": "PublicPort",           "type": "port",     "label_de": "Port",                 "label_en": "Port"},
      {"key": "ServerPlayerMaxNum",   "type": "int",      "label_de": "Max. Spieler",         "label_en": "Max players"},
      {"key": "Difficulty",           "type": "text",     "label_de": "Schwierigkeit",        "label_en": "Difficulty"},
      {"key": "RCONEnabled",          "type": "bool",     "label_de": "RCON aktiv",           "label_en": "RCON enabled"},
      {"key": "RCONPort",             "type": "port",     "label_de": "RCON-Port",            "label_en": "RCON port"},
      {"key": "RESTAPIEnabled",       "type": "bool",     "label_de": "REST-API aktiv",       "label_en": "REST API enabled"},
      {"key": "RESTAPIPort",          "type": "port",     "label_de": "REST-API-Port",        "label_en": "REST API port"}
