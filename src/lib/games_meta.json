{
  "mcserver": {
    "name": "Minecraft (Vanilla)",
    "steam_required": false,
    "start_ready_log": "latest_log",
    "start_ready_regex": "Done \\([0-9.]+s\\)!",
    "start_ready_secs": 600,
    "start_stall_secs": 120,
    "start_stall_fail_secs": 300,
    "start_phases": [
      {"id": "mod_loader", "label_de": "Mod-Loader", "label_en": "Mod loader", "match": "Starting FancyModLoader|Forge Mod Loader|Fabric Loader|Loading Minecraft"},
      {"id": "mod_list", "label_de": "Mod-Liste", "label_en": "Mod list", "match": "Mod List:"},
      {"id": "preparing", "label_de": "Welt vorbereiten", "label_en": "Preparing world", "match": "Preparing level|Preparing spawn area"},
      {"id": "ready", "label_de": "Bereit", "label_en": "Ready", "match": "Done \\([0-9.]+s\\)!"}
    ],
    "stop_grace_secs": 120,
    "stop_force_secs": 180,
    "stop_phases": [
      {"id": "saving", "label_de": "Speichern", "label_en": "Saving", "match": "Saving chunks|Saving the game|[Ss]aving"},
      {"id": "stopped", "label_de": "Gestoppt", "label_en": "Stopped", "match": "All dimensions are saved|Server stopped|Stopping the server"}
    ],
    "variants": ["mcserver", "mc-paper", "mc-forge", "mc-neoforge", "mc-fabric"],
    "game_config_path": "serverfiles/server.properties",
    "game_config_format": "properties",
    "game_config_fields": [
      {"key": "server-port",    "type": "port",     "label_de": "Port",          "label_en": "Port"},
      {"key": "max-players",    "type": "int",      "label_de": "Max. Spieler",  "label_en": "Max players"},
      {"key": "motd",           "type": "text",     "label_de": "Servermotto",   "label_en": "MOTD"},
      {"key": "difficulty",     "type": "text",     "label_de": "Schwierigkeit", "label_en": "Difficulty"},
      {"key": "gamemode",       "type": "text",     "label_de": "Spielmodus",    "label_en": "Game mode"},
      {"key": "level-name",     "type": "text",     "label_de": "Weltname",      "label_en": "World name"},
      {"key": "online-mode",    "type": "text",     "label_de": "Online-Modus",  "label_en": "Online mode"},
      {"key": "pvp",            "type": "text",     "label_de": "PvP",           "label_en": "PvP"},
      {"key": "enable-rcon",    "type": "bool",     "label_de": "RCON aktiv",    "label_en": "RCON enabled"},
      {"key": "rcon.port",      "type": "port",     "label_de": "RCON-Port",     "label_en": "RCON port"},
      {"key": "rcon.password",  "type": "password", "label_de": "RCON-Passwort", "label_en": "RCON password"}
    ],
    "player_query": {
      "kind": "rcon",
      "source": "game_config",
      "enabled_key": "enable-rcon",
      "port_key": "rcon.port",
      "password_key": "rcon.password",
      "max_players_key": "max-players",
      "command": "list",
      "parse": "mc_list"
    },
    "fields": [
      {"key": "port",       "type": "port",   "label_de": "Port",         "label_en": "Port",          "default": "25565"},
      {"key": "gamename",   "type": "text",   "label_de": "Spielname",    "label_en": "Game name",     "default": "Minecraft"},
      {"key": "maxplayers", "type": "int",    "label_de": "Max. Spieler", "label_en": "Max players",   "default": "20"},
      {"key": "slots",      "type": "int",    "label_de": "Slots",        "label_en": "Slots",         "default": "20"}
    ]
  },
